<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.niri_settings.NiriSettings</id>
  <name>niri settings</name>
  <summary>Change niri settings safely</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>
      Change the niri config with a graphical interface.
      Every change is checked with niri validate and can be undone.
      Comments and formatting in the file stay intact.
    </p>
    <p>
      The app finds problems, imports shortcuts from Hyprland or Sway,
      and shows a live picture for visual options.
    </p>
  </description>
  <launchable type="desktop-id">io.github.niri_settings.NiriSettings.desktop</launchable>
  <screenshots>
